---
import Layout from "../layouts/Layout.astro";
import VideoPlayer from "../components/VideoPlayer.svelte";
import SystemMonitor from "../components/SystemMonitor.svelte";
---

<Layout title="Dashboard — Security Cam">
	<div class="mx-auto max-w-6xl space-y-4 sm:space-y-5">
		<!-- Header -->
		<div class="flex items-center justify-between">
			<h1 class="text-base font-semibold text-text-primary sm:text-lg">
				Dashboard
			</h1>
			<div
				class="flex items-center gap-2 rounded-full border border-status-ok/20 bg-status-ok/8 px-3 py-1">
				<span
					class="h-1.5 w-1.5 rounded-full bg-status-ok shadow-[0_0_6px_rgba(45,212,168,0.5)]"
				></span>
				<span
					class="text-[11px] font-medium text-status-ok">
					Online
				</span>
			</div>
		</div>

		<div class="grid grid-cols-1 items-start gap-4 sm:gap-5 lg:grid-cols-3">
			<!-- Live Feed (takes 2 cols on desktop) -->
			<div class="min-w-0 lg:col-span-2">
				<h2
					class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-text-muted">
					Live Feed
				</h2>
				<VideoPlayer client:load />
			</div>

			<!-- System Monitor -->
			<div class="min-w-0">
				<h2
					class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-text-muted">
					System Health
				</h2>
				<SystemMonitor client:load />
			</div>
		</div>

		<!-- Access Log -->
		<section>
			<div class="flex items-center justify-between mb-3">
				<h2
					class="text-[11px] font-semibold uppercase tracking-wider text-text-muted">
					Access Log
				</h2>
				<span class="text-[11px] text-text-muted">Last 24h</span>
			</div>
			<div class="card overflow-hidden">
				<div class="overflow-x-auto">
					<table class="w-full text-left text-sm">
						<thead>
							<tr
								class="border-b border-border-default text-[11px] font-medium uppercase tracking-wider text-text-muted">
								<th class="whitespace-nowrap px-4 py-3 sm:px-5"
									>Device</th
								>
								<th class="whitespace-nowrap px-4 py-3 sm:px-5"
									>Date</th
								>
								<th class="whitespace-nowrap px-4 py-3 sm:px-5"
									>Time</th
								>
								<th class="whitespace-nowrap px-4 py-3 sm:px-5"
									>Status</th
								>
								<th
									class="hidden whitespace-nowrap px-4 py-3 sm:table-cell sm:px-5"
									>Event</th
								>
							</tr>
						</thead>
						<tbody class="divide-y divide-border-subtle">
							<tr
								class="transition-colors hover:bg-surface-overlay/40">
								<td
									class="whitespace-nowrap px-4 py-3 font-medium text-text-primary sm:px-5"
									>iPhone (John)</td
								>
								<td
									class="whitespace-nowrap px-4 py-3 tabular-nums text-text-secondary sm:px-5"
									>2025-03-28</td
								>
								<td
									class="whitespace-nowrap px-4 py-3 tabular-nums text-text-secondary sm:px-5"
									>08:32</td
								>
								<td class="whitespace-nowrap px-4 py-3 sm:px-5"
									><span
										class="inline-flex items-center gap-1.5 text-status-ok"
										><span
											class="h-1.5 w-1.5 rounded-full bg-current"
										></span>Connected</span
									></td
								>
								<td
									class="hidden whitespace-nowrap px-4 py-3 text-text-secondary sm:table-cell sm:px-5"
									>Arrived</td
								>
							</tr>
							<tr
								class="transition-colors hover:bg-surface-overlay/40">
								<td
									class="whitespace-nowrap px-4 py-3 font-medium text-text-primary sm:px-5"
									>iPhone (John)</td
								>
								<td
									class="whitespace-nowrap px-4 py-3 tabular-nums text-text-secondary sm:px-5"
									>2025-03-28</td
								>
								<td
									class="whitespace-nowrap px-4 py-3 tabular-nums text-text-secondary sm:px-5"
									>17:45</td
								>
								<td class="whitespace-nowrap px-4 py-3 sm:px-5"
									><span
										class="inline-flex items-center gap-1.5 text-text-muted"
										><span
											class="h-1.5 w-1.5 rounded-full bg-current"
										></span>Disconnected</span
									></td
								>
								<td
									class="hidden whitespace-nowrap px-4 py-3 text-text-secondary sm:table-cell sm:px-5"
									>Left</td
								>
							</tr>
							<tr
								class="transition-colors hover:bg-surface-overlay/40">
								<td
									class="whitespace-nowrap px-4 py-3 font-medium text-text-primary sm:px-5"
									>Galaxy (Jane)</td
								>
								<td
									class="whitespace-nowrap px-4 py-3 tabular-nums text-text-secondary sm:px-5"
									>2025-03-27</td
								>
								<td
									class="whitespace-nowrap px-4 py-3 tabular-nums text-text-secondary sm:px-5"
									>09:10</td
								>
								<td class="whitespace-nowrap px-4 py-3 sm:px-5"
									><span
										class="inline-flex items-center gap-1.5 text-status-ok"
										><span
											class="h-1.5 w-1.5 rounded-full bg-current"
										></span>Connected</span
									></td
								>
								<td
									class="hidden whitespace-nowrap px-4 py-3 text-text-secondary sm:table-cell sm:px-5"
									>Arrived</td
								>
							</tr>
							<tr
								class="transition-colors hover:bg-surface-overlay/40">
								<td
									class="whitespace-nowrap px-4 py-3 font-medium text-text-primary sm:px-5"
									>Galaxy (Jane)</td
								>
								<td
									class="whitespace-nowrap px-4 py-3 tabular-nums text-text-secondary sm:px-5"
									>2025-03-27</td
								>
								<td
									class="whitespace-nowrap px-4 py-3 tabular-nums text-text-secondary sm:px-5"
									>18:20</td
								>
								<td class="whitespace-nowrap px-4 py-3 sm:px-5"
									><span
										class="inline-flex items-center gap-1.5 text-text-muted"
										><span
											class="h-1.5 w-1.5 rounded-full bg-current"
										></span>Disconnected</span
									></td
								>
								<td
									class="hidden whitespace-nowrap px-4 py-3 text-text-secondary sm:table-cell sm:px-5"
									>Left</td
								>
							</tr>
							<tr
								class="transition-colors hover:bg-surface-overlay/40">
								<td
									class="whitespace-nowrap px-4 py-3 font-medium text-text-primary sm:px-5"
									>iPad (Office)</td
								>
								<td
									class="whitespace-nowrap px-4 py-3 tabular-nums text-text-secondary sm:px-5"
									>2025-03-26</td
								>
								<td
									class="whitespace-nowrap px-4 py-3 tabular-nums text-text-secondary sm:px-5"
									>07:00</td
								>
								<td class="whitespace-nowrap px-4 py-3 sm:px-5"
									><span
										class="inline-flex items-center gap-1.5 text-status-ok"
										><span
											class="h-1.5 w-1.5 rounded-full bg-current"
										></span>Connected</span
									></td
								>
								<td
									class="hidden whitespace-nowrap px-4 py-3 text-text-secondary sm:table-cell sm:px-5"
									>Arrived</td
								>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</section>

		<!-- Activity Timeline -->
		<section>
			<h2
				class="mb-3 text-[11px] font-semibold uppercase tracking-wider text-text-muted">
				Activity Timeline
			</h2>
			<div class="card px-6 py-10 text-center">
				<svg
					class="mx-auto h-8 w-8 text-text-muted/20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5">
					<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"
					></polyline>
				</svg>
				<p class="mt-2.5 text-[13px] text-text-muted">
					Activity timeline coming soon
				</p>
			</div>
		</section>
	</div>
</Layout>
