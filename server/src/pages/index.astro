---
import Layout from "../layouts/Layout.astro";
import VideoPlayer from "../components/VideoPlayer.svelte";
import SystemMonitor from "../components/SystemMonitor.svelte";
import HealthTracker from "../components/HealthTracker.svelte";
import EventTracker from "../components/EventTracker.svelte";
---

<Layout title="Dashboard — Security Cam">
	<div class="mx-auto max-w-6xl">
		<!-- Header -->
		<div class="animate-in flex items-center justify-between">
			<h1 class="text-lg font-bold tracking-tight text-text-primary sm:text-xl">
				Dashboard
			</h1>
			<div
				class="flex items-center gap-2 rounded-full border border-status-ok/15 bg-status-ok/6 px-3 py-1.5">
				<span
					class="status-live h-1.5 w-1.5 rounded-full bg-status-ok shadow-[0_0_6px_rgba(52,217,172,0.5)]"
				></span>
				<span
					class="text-[0.75rem] font-semibold text-status-ok">
					Online
				</span>
			</div>
		</div>

		<div class="mt-4 grid grid-cols-1 items-start gap-4 sm:mt-5 sm:gap-5 lg:grid-cols-3">
			<!-- Live Feed (takes 2 cols on desktop) -->
			<div class="animate-in stagger-1 min-w-0 lg:col-span-2">
				<h2 class="section-label mb-2.5">
					Live Feed
				</h2>
				<VideoPlayer client:load />
			</div>

			<!-- System Monitor -->
			<div class="animate-in stagger-2 min-w-0 flex flex-col gap-2.5">
				<h2 class="section-label">
					System Health
				</h2>
				<SystemMonitor client:load />
				<EventTracker client:load />
				<HealthTracker client:load />
			</div>
		</div>

		<!-- Access Log -->
		<section class="animate-in stagger-3 mt-6 sm:mt-8">
			<div class="flex items-center justify-between mb-3">
				<h2 class="section-label">Access Log</h2>
				<span class="text-[0.625rem] tabular-nums text-text-muted">Last 24h</span>
			</div>
			<!-- Mobile: stacked cards -->
			<div class="card divide-y divide-border-subtle sm:hidden">
				<div class="flex items-center justify-between px-4 py-3">
					<div class="min-w-0">
						<p class="text-sm font-medium text-text-primary">iPhone (John)</p>
						<p class="mt-0.5 text-[0.6875rem] tabular-nums text-text-secondary">2025-03-28 &middot; 08:32</p>
					</div>
					<span class="inline-flex items-center gap-1.5 text-[0.8125rem] text-status-ok">
						<span class="h-1.5 w-1.5 rounded-full bg-current"></span>Arrived
					</span>
				</div>
				<div class="flex items-center justify-between px-4 py-3">
					<div class="min-w-0">
						<p class="text-sm font-medium text-text-primary">iPhone (John)</p>
						<p class="mt-0.5 text-[0.6875rem] tabular-nums text-text-secondary">2025-03-28 &middot; 17:45</p>
					</div>
					<span class="inline-flex items-center gap-1.5 text-[0.8125rem] text-text-muted">
						<span class="h-1.5 w-1.5 rounded-full bg-current"></span>Left
					</span>
				</div>
				<div class="flex items-center justify-between px-4 py-3">
					<div class="min-w-0">
						<p class="text-sm font-medium text-text-primary">Galaxy (Jane)</p>
						<p class="mt-0.5 text-[0.6875rem] tabular-nums text-text-secondary">2025-03-27 &middot; 09:10</p>
					</div>
					<span class="inline-flex items-center gap-1.5 text-[0.8125rem] text-status-ok">
						<span class="h-1.5 w-1.5 rounded-full bg-current"></span>Arrived
					</span>
				</div>
				<div class="flex items-center justify-between px-4 py-3">
					<div class="min-w-0">
						<p class="text-sm font-medium text-text-primary">Galaxy (Jane)</p>
						<p class="mt-0.5 text-[0.6875rem] tabular-nums text-text-secondary">2025-03-27 &middot; 18:20</p>
					</div>
					<span class="inline-flex items-center gap-1.5 text-[0.8125rem] text-text-muted">
						<span class="h-1.5 w-1.5 rounded-full bg-current"></span>Left
					</span>
				</div>
				<div class="flex items-center justify-between px-4 py-3">
					<div class="min-w-0">
						<p class="text-sm font-medium text-text-primary">iPad (Office)</p>
						<p class="mt-0.5 text-[0.6875rem] tabular-nums text-text-secondary">2025-03-26 &middot; 07:00</p>
					</div>
					<span class="inline-flex items-center gap-1.5 text-[0.8125rem] text-status-ok">
						<span class="h-1.5 w-1.5 rounded-full bg-current"></span>Arrived
					</span>
				</div>
			</div>

			<!-- Desktop: table -->
			<div class="card hidden overflow-hidden sm:block">
				<div class="overflow-x-auto">
					<table class="w-full text-left text-sm">
						<thead>
							<tr
								class="border-b border-border-default text-[0.6875rem] font-medium uppercase tracking-wider text-text-muted">
								<th class="whitespace-nowrap px-5 py-3"
									>Device</th
								>
								<th class="whitespace-nowrap px-5 py-3"
									>Date</th
								>
								<th class="whitespace-nowrap px-5 py-3"
									>Time</th
								>
								<th class="whitespace-nowrap px-5 py-3"
									>Status</th
								>
								<th class="whitespace-nowrap px-5 py-3"
									>Event</th
								>
							</tr>
						</thead>
						<tbody class="divide-y divide-border-subtle">
							<tr
								class="transition-colors hover:bg-surface-overlay/40">
								<td
									class="whitespace-nowrap px-5 py-3 font-medium text-text-primary"
									>iPhone (John)</td
								>
								<td
									class="whitespace-nowrap px-5 py-3 tabular-nums text-text-secondary"
									>2025-03-28</td
								>
								<td
									class="whitespace-nowrap px-5 py-3 tabular-nums text-text-secondary"
									>08:32</td
								>
								<td class="whitespace-nowrap px-5 py-3"
									><span
										class="inline-flex items-center gap-1.5 text-status-ok"
										><span
											class="h-1.5 w-1.5 rounded-full bg-current"
										></span>Connected</span
									></td
								>
								<td
									class="whitespace-nowrap px-5 py-3 text-text-secondary"
									>Arrived</td
								>
							</tr>
							<tr
								class="transition-colors hover:bg-surface-overlay/40">
								<td
									class="whitespace-nowrap px-5 py-3 font-medium text-text-primary"
									>iPhone (John)</td
								>
								<td
									class="whitespace-nowrap px-5 py-3 tabular-nums text-text-secondary"
									>2025-03-28</td
								>
								<td
									class="whitespace-nowrap px-5 py-3 tabular-nums text-text-secondary"
									>17:45</td
								>
								<td class="whitespace-nowrap px-5 py-3"
									><span
										class="inline-flex items-center gap-1.5 text-text-muted"
										><span
											class="h-1.5 w-1.5 rounded-full bg-current"
										></span>Disconnected</span
									></td
								>
								<td
									class="whitespace-nowrap px-5 py-3 text-text-secondary"
									>Left</td
								>
							</tr>
							<tr
								class="transition-colors hover:bg-surface-overlay/40">
								<td
									class="whitespace-nowrap px-5 py-3 font-medium text-text-primary"
									>Galaxy (Jane)</td
								>
								<td
									class="whitespace-nowrap px-5 py-3 tabular-nums text-text-secondary"
									>2025-03-27</td
								>
								<td
									class="whitespace-nowrap px-5 py-3 tabular-nums text-text-secondary"
									>09:10</td
								>
								<td class="whitespace-nowrap px-5 py-3"
									><span
										class="inline-flex items-center gap-1.5 text-status-ok"
										><span
											class="h-1.5 w-1.5 rounded-full bg-current"
										></span>Connected</span
									></td
								>
								<td
									class="whitespace-nowrap px-5 py-3 text-text-secondary"
									>Arrived</td
								>
							</tr>
							<tr
								class="transition-colors hover:bg-surface-overlay/40">
								<td
									class="whitespace-nowrap px-5 py-3 font-medium text-text-primary"
									>Galaxy (Jane)</td
								>
								<td
									class="whitespace-nowrap px-5 py-3 tabular-nums text-text-secondary"
									>2025-03-27</td
								>
								<td
									class="whitespace-nowrap px-5 py-3 tabular-nums text-text-secondary"
									>18:20</td
								>
								<td class="whitespace-nowrap px-5 py-3"
									><span
										class="inline-flex items-center gap-1.5 text-text-muted"
										><span
											class="h-1.5 w-1.5 rounded-full bg-current"
										></span>Disconnected</span
									></td
								>
								<td
									class="whitespace-nowrap px-5 py-3 text-text-secondary"
									>Left</td
								>
							</tr>
							<tr
								class="transition-colors hover:bg-surface-overlay/40">
								<td
									class="whitespace-nowrap px-5 py-3 font-medium text-text-primary"
									>iPad (Office)</td
								>
								<td
									class="whitespace-nowrap px-5 py-3 tabular-nums text-text-secondary"
									>2025-03-26</td
								>
								<td
									class="whitespace-nowrap px-5 py-3 tabular-nums text-text-secondary"
									>07:00</td
								>
								<td class="whitespace-nowrap px-5 py-3"
									><span
										class="inline-flex items-center gap-1.5 text-status-ok"
										><span
											class="h-1.5 w-1.5 rounded-full bg-current"
										></span>Connected</span
									></td
								>
								<td
									class="whitespace-nowrap px-5 py-3 text-text-secondary"
									>Arrived</td
								>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</section>

		<!-- Activity Timeline -->
		<section class="animate-in stagger-4 mt-6 sm:mt-8">
			<h2 class="section-label mb-3">
				Activity Timeline
			</h2>
			<div class="card px-6 py-10 text-center">
				<svg
					class="mx-auto h-8 w-8 text-text-muted/15"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5">
					<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"
					></polyline>
				</svg>
				<p class="mt-2.5 text-[0.8125rem] text-text-muted">
					Activity timeline coming soon
				</p>
			</div>
		</section>
	</div>
</Layout>
