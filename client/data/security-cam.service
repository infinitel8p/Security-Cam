[Unit]
Description=Security-Cam (Flask API + Astro frontend)
After=network.target hostapd.service mediamtx.service

[Service]
Type=forking
User=root
WorkingDirectory=/opt/security-cam
ExecStartPre=/opt/security-cam/setup/update.sh
ExecStart=/opt/security-cam/start.sh
TimeoutStartSec=300
Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
