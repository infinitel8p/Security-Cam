---
import Layout from "../layouts/Layout.astro";
import LogViewer from "../components/LogViewer.svelte";
import I18nText from "../components/I18nText.svelte";
import Icon from "../components/Icon.svelte";
import fileTextIcon from "../icons/file-text.svg?raw";
---

<Layout title="Logs - Security Cam">
	<div class="mx-auto max-w-6xl">
		<div class="animate-in flex items-center gap-3.5">
			<div
				class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent/10 shadow-[0_0_20px_rgba(77,148,255,0.08)]">
				<Icon icon={fileTextIcon} class="size-5 text-accent" />
			</div>
			<h1
				class="text-xl font-bold tracking-tight text-text-primary sm:text-2xl">
				<I18nText key="page.logs" fallback="Logs" client:load />
			</h1>
		</div>
		<LogViewer client:load />
	</div>
</Layout>
