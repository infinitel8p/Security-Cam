[Unit]
Description=Security-Cam (Flask API + Astro frontend)
After=network-online.target hostapd.service mediamtx.service
Wants=network-online.target

[Service]
Type=forking
User=root
WorkingDirectory=/opt/security-cam
ExecStartPre=/opt/security-cam/setup/update.sh
ExecStart=/opt/security-cam/start.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
